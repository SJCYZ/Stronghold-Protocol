{
  "$schema": "../../schemas/plugin.schema.json",
  "manifest": 2,
  "name": {
    "zh": "房主手动调速",
    "en": "Host combat speed"
  },
  "description": {
    "zh": "房间选入后显示房主手动调速滑条；速度仅在当前对局内沿用。",
    "en": "Adds a host-only manual speed slider for the current match."
  },
  "version": "1.0.0",
  "app": ">=0.3.0 <0.4.0",
  "api": 1,
  "class": "script",
  "scope": [
    "room"
  ],
  "id": "combat-speed",
  "permissions": [
    "sim.code",
    "clock.speed"
  ],
  "entry": {
    "sim": "sim/index.js"
  }
}
